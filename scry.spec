# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for the M5 standalone `scry` bundle.

Build (CI-only tool; not a runtime or dev dependency):
    pip install pyinstaller==6.11.1 && pip install -e .
    pyinstaller scry.spec --noconfirm      -> dist/scry/scry

onedir, deliberately: --onefile re-extracts to a temp dir on every launch,
which would undercut the sub-50 ms lookup SLA and break sys.executable.
"""
import pathlib

# Generate scry_cli/_buildinfo.py from pyproject so a bundle without package
# metadata still reports the real version (PyInstaller ships no dist-info).
_ROOT = pathlib.Path(SPECPATH)
_version = "0+unknown"
for _line in (_ROOT / "pyproject.toml").read_text().splitlines():
    if _line.startswith("version = "):
        _version = _line.split("=", 1)[1].strip().strip('"')
        break
(_ROOT / "scry_cli" / "_buildinfo.py").write_text(
    '# Generated by scry.spec at build time. Do not edit or commit.\nVERSION = "%s"\n'
    % _version
)

a = Analysis(
    ["scry"],
    pathex=[],
    binaries=[],
    # Without this the bundled alias map is absent and flavor-name lookups
    # silently stop resolving, even though aliases.py checks sys._MEIPASS.
    datas=[("scry_cli/data/aliases.json", "scry_cli/data")],
    hiddenimports=[],
    hookspath=[],
    runtime_hooks=[],
    # Stdlib modules scry never touches; trimming these keeps the bundle small.
    excludes=["tkinter", "unittest", "pydoc", "test", "distutils", "lib2to3", "idlelib"],
    noarchive=False,
)

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="scry",
    debug=False,
    strip=False,
    upx=False,
    # console=True keeps stdout data / stderr diagnostics separate: the whole
    # JSONL agent contract depends on it.
    console=True,
)

coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    name="scry",
)
