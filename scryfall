#!/usr/bin/env python3
"""scryfall — executable shim.

The implementation lives in the scryfall_cli/ package next to this file (see
README "Project layout"). This shim keeps the install story simple — `chmod +x
scryfall` still works, and `update_cache.sh` calling `./scryfall reindex` still
works — while the parity harness imports the package directly instead of
loading this file by path.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from scryfall_cli.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
